# Server configuration (copy to .env for local overrides; .env is git-ignored).
# Local dev needs no TLS and no nginx — plain ws:// on this port.
PORT=2567

# Supabase (accounts) — set these in .env locally and in the VPS .env in production.
# SUPABASE_URL is the base project URL (https://<ref>.supabase.co, no /rest/v1/ path).
# SUPABASE_SECRET_KEY is the SECRET / service-role key — keep it private, never commit it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
