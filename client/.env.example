# Client build/runtime configuration (copy to .env to override locally).
# The Colyseus server endpoint. Defaults to ws://localhost:2567 in dev when unset.
# In production set this to wss://<your-domain>/colyseus (see docs/deployment.md).
VITE_SERVER_URL=ws://localhost:2567

# Donation link (Ko-fi). Set to your page, e.g. https://ko-fi.com/yourname
VITE_KOFI_URL=https://ko-fi.com/yourpage

# Supabase (accounts). Both are PUBLIC and safe to embed/commit. The publishable/anon key
# is the public client key (NOT the secret key, which lives only on the server).
VITE_SUPABASE_URL=https://yourref.supabase.co
VITE_SUPABASE_ANON_KEY=

# App store links for the home footer (leave empty until the listings are live).
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Ads. CrazyGames is detected automatically when the site runs inside their iframe (no flag needed).
# For the standalone site, set your approved Google AdSense client id (e.g. ca-pub-1234567890123456).
# Leave empty in dev so no ads show.
VITE_ADSENSE_CLIENT=
