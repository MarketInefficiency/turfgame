# Production build values, baked into the client by `vite build`. Committed on purpose
# (no secrets here) so every deploy points at the live server regardless of any local
# .env. Local `npm run dev` ignores this file and keeps using ws://localhost:2567.
VITE_SERVER_URL=wss://turfgame.io/colyseus
VITE_KOFI_URL=https://ko-fi.com/turfgameio
# Supabase accounts (both PUBLIC — the publishable/anon key, never the secret). Required at build
# time so accounts/shop/sign-in are enabled in EVERY build (web + Codemagic native), not just the VPS.
VITE_SUPABASE_URL=https://derxaiqacejjzgdqlsdr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IKOiE7lmQucUIlo3300Wlw_hMF6cY4b
# RevenueCat public SDK key (iOS) — PUBLIC, safe to commit. Fill from the RevenueCat dashboard to
# turn on in-app purchases in the native app. Empty = IAP no-ops (web/dev unaffected).
VITE_REVENUECAT_IOS_KEY=
